# 目标位置：frontend/.env.example
# 用法：复制成 frontend/.env（已在根 .gitignore 中忽略）

# 后端地址：本地开发用默认值；部署或换端口时改这里
VITE_API_BASE_URL=http://127.0.0.1:8000

# 高德开放平台 · JS API Key（浏览器端地图）
# 申请地址：https://console.amap.com/dev/key/app ，类型选「Web端(JS API)」
VITE_AMAP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 与上面 JS API Key 配套的「安全密钥」
# 注意：两个组件读的变量名目前不一致，两个都填最省事
#   - src/modules/RightSidebar/components/MapContainer.vue   → VITE_AMAP_SECURITY_KEY
#   - src/views/admin/ResourceManage/components/ResourceMapPreview.vue → VITE_AMAP_SECURITY_CODE
VITE_AMAP_SECURITY_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AMAP_SECURITY_CODE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
